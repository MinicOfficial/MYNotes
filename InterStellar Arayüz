function openTask(taskDef){
  state.activeTask = taskDef;
  document.getElementById('taskTitle').textContent = taskDef.label;
  document.getElementById('taskSub').textContent = meP().isImpostor
    ? 'Şüphe çekmemek için görevi yapıyormuş gibi yap.'
    : 'Görevi tamamlamak için aşağıdaki adımı bitir.';
  const clicksWrap = document.getElementById('taskClicksWrap');
  const holdWrap = document.getElementById('taskHoldWrap');
  if(taskDef.type==='clicks'){
    clicksWrap.style.display='block'; holdWrap.style.display='none';
    let count = 0;
    const need = taskDef.need || 6;
    document.getElementById('clickCount').textContent = count+' / '+need;
    const btn = document.getElementById('btnClickTask');
    const handler = ()=>{
      count++;
      document.getElementById('clickCount').textContent = count+' / '+need;
      if(count>=need){ btn.removeEventListener('click', handler); completeTask(taskDef); }
    };
    btn._handler = handler;
    btn.addEventListener('click', handler);
  } else {
    clicksWrap.style.display='none'; holdWrap.style.display='block';
    const bar = document.getElementById('holdBar');
    let progress = 0; bar.style.width='0%';
    let holding = false;
    const btn = document.getElementById('btnHoldTask');
    function step(){
      if(!state.activeTask) return;
      if(holding) progress += 1.6; else progress -= 0.8;
      progress = clamp(progress,0,100);
      bar.style.width = progress+'%';
      if(progress>=100){ cleanup(); completeTask(taskDef); return; }
      btn._raf = requestAnimationFrame(step);
    }
    function down(ev){ ev.preventDefault(); holding = true; }
    function up(ev){ holding = false; }
    function cleanup(){
      btn.removeEventListener('pointerdown', down);
      window.removeEventListener('pointerup', up);
      if(btn._raf) cancelAnimationFrame(btn._raf);
    }
    btn.addEventListener('pointerdown', down);
    window.addEventListener('pointerup', up);
    btn._cleanup = cleanup;
    btn._raf = requestAnimationFrame(step);
  }
  document.getElementById('overlayTask').classList.add('active');
}
function closeTaskOverlay(){
  const btn = document.getElementById('btnClickTask');
  const btn2 = document.getElementById('btnHoldTask');
  if(btn._handler){ btn.removeEventListener('click', btn._handler); btn._handler=null; }
