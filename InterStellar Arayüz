function gameTick(ts, runId){
  if(runId!==undefined && state.gameRunId !== runId) return;
  const dt = Math.min(0.05, (ts - state.lastTs)/1000 || 0);
  state.lastTs = ts;

  if(!state.meetingOpen && !state.gameOver && !state.activeTask && !document.getElementById('overlayCameras').classList.contains('active')){
    updatePlayer(dt);
    updateBots(dt);
    updateInteractPrompt();
  }
  if(document.getElementById('overlayCameras').classList.contains('active')){ renderCameraView(); }
  if(state.killCooldown>0) state.killCooldown -= dt;
  if(state.lightsCooldown>0) state.lightsCooldown -= dt;
  if(state.doorsCooldown>0) state.doorsCooldown -= dt;
  if(state.lightsOff && performance.now() > state.lightsOffUntil) state.lightsOff = false;
  updateKillButton();
  updateSabotageButtons();
  updateLightsOverlay();

  if(!state.gameOver && !state.meetingOpen){
    checkWin();
    if(state.gameOver) onGameOver();
  }

  render();
  requestAnimationFrame((ts2)=>gameTick(ts2, runId));
}

function updatePlayer(dt){
  const p = meP();
  let dx=0, dy=0;
  if(state.keys.up) dy -= 1;
  if(state.keys.down) dy += 1;
  if(state.keys.left) dx -= 1;
  if(state.keys.right) dx += 1;
  if(dx!==0 || dy!==0){
    const len = Math.hypot(dx,dy);
    dx/=len; dy/=len;
    const spd = p.alive ? SPEED : SPEED*1.2;
    const nx = p.x + dx*spd*dt;
    const ny = p.y + dy*spd*dt;
    if(p.alive){
      if(isWalkable(nx, p.y, R)) p.x = nx;
      if(isWalkable(p.x, ny, R)) p.y = ny;
    } else {
      p.x = nx; p.y = ny;
    }
    p.x = clamp(p.x, R, WORLD_W-R);
    p.y = clamp(p.y, R, WORLD_H-R);
    if(dx!==0) p.facing = dx<0 ? 'left' : 'right';
    p.walking = true;
    p.walkT = (p.walkT||0) + dt;
  } else {
    p.walking = false;
  }
}

function assignBotTarget(b){
  const shipRooms = ROOMS.filter(r=>r.key!=='waitingroom');
  if(!b.isImpostor){
    const undone = TASKS_DEF.filter(t=> b.myTasks.includes(t.id) && !b.tasksDone[t.id]);
    if(undone.length && Math.random()<0.75){
      const t = pick(undone);
      b.target = {x:t.x, y:t.y, taskId:t.id};
    } else {
      const room = pick(shipRooms);
      b.target = {x: rand(room.x+30, room.x+room.w-30), y: rand(room.y+30, room.y+room.h-30)};
    }
  } else {
    const room = pick(shipRooms);
    b.target = {x: rand(room.x+30, room.x+room.w-30), y: rand(room.y+30, room.y+room.h-30)};
  }
  b.path = findPathTo(b.x, b.y, b.target.x, b.target.y);
  b.pathIndex = 0;
}

function updateBots(dt){
  for(const b of state.players){
    if(!b.isBot || !b.alive) continue;

    if(b.workTimer > 0){
      b.workTimer -= dt;
      if(b.workTimer<=0){
        if(b.target && b.target.taskId && b.myTasks.includes(b.target.taskId) && !b.tasksDone[b.target.taskId]){
          b.tasksDone[b.target.taskId] = true;
          if(b.id==='me') updateTaskChip();
        }
        b.target = null; b.path = null;
      }
    } else {
      if(!b.target || !b.path){ assignBotTarget(b); }
      const wp = b.path[b.pathIndex];
      const ddx = wp.x-b.x, ddy = wp.y-b.y;
      const dd = Math.hypot(ddx,ddy);
      if(dd < 14){
        b.pathIndex++;
        if(b.pathIndex >= b.path.length){
          if(b.target.taskId){ b.workTimer = rand(2.2,4); }
          else { b.target = null; b.path = null; b.nextTurn = rand(0.4,1.2); }
        }
      } else {
        const ux = ddx/dd, uy = ddy/dd;
        const nx = b.x+ux*b.speed*dt, ny = b.y+uy*b.speed*dt;
        let moved = false;
        if(isWalkable(nx, ny, R)){ b.x=nx; b.y=ny; moved=true; }
        else if(isWalkable(nx, b.y, R)){ b.x=nx; moved=true; }
        else if(isWalkable(b.x, ny, R)){ b.y=ny; moved=true; }
        if(!moved){ b.target = null; b.path = null; }
        if(moved){
          if(Math.abs(ux)>0.15) b.facing = ux<0 ? 'left' : 'right';
          b.walking = true;
          b.walkT = (b.walkT||0) + dt;
        }
      }
    }
    if(b.workTimer > 0 || (!b.target && !b.path)){ b.walking = false; }

    if(b.isImpostor){
      b.killCd -= dt;
      if(b.killCd<=0){
        const victims = state.players.filter(pl=>pl.alive && !pl.isImpostor);
        if(victims.length>0){ killPlayer(pick(victims)); }
        b.killCd = rand(16,30);
      }
      b.sabCd -= dt;
      if(b.sabCd<=0){
        if(Math.random()<0.5){
          if(botSabotageLights(b)) b.sabCd = rand(28,55); else b.sabCd = rand(6,12);
        } else {
          if(botLockDoors(b)) b.sabCd = rand(28,55); else b.sabCd = rand(6,12);
        }
      }
    }
  }
}

function nearestInteractable(){
  const p = meP();
  const ghost = !p.alive;
  let best = null, bestD = Infinity;
  if(!ghost){
    for(const body of state.bodies){
      const d = dist(p.x,p.y, body.x, body.y);
      if(d < 55 && d < bestD){ best = {type:'report', ref:body}; bestD = d; }
    }
    const de = dist(p.x,p.y, EMERGENCY.x, EMERGENCY.y);
    if(de < 60 && de < bestD){ best = {type:'emergency'}; bestD = de; }
    if(!p.isImpostor && state.lightsOff){
      const dl = dist(p.x,p.y, LIGHTS_FIX.x, LIGHTS_FIX.y);
      if(dl < 55 && dl < bestD){ best = {type:'fixlights'}; bestD = dl; }
    }
    const dc = dist(p.x,p.y, CAMERA_PANEL.x, CAMERA_PANEL.y);
    if(dc < 55 && dc < bestD){ best = {type:'cameras'}; bestD = dc; }
  }
  for(const t of TASKS_DEF){
    if(!p.myTasks.includes(t.id)) continue;
    if(p.tasksDone[t.id] && !p.isImpostor) continue;
    const d = dist(p.x,p.y, t.x, t.y);
    if(d < 55 && d < bestD){ best = {type:'task', ref:t}; bestD = d; }
  }
  return best;
}

