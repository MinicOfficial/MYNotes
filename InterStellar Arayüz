function buildPlayers(){
  const cap = state.settings.capacity;
  const impCount = Math.min(state.settings.impostors, Math.max(1, Math.floor(cap/2)-1));
  if(!state.me.name || !state.me.name.trim()) state.me.name = pick(NAME_POOL);
  state.me.name = state.me.name.trim().slice(0,18);
  const myNameLower = state.me.name.toLowerCase();
  const availableNames = shuffle(NAME_POOL.filter(n=>n.toLowerCase()!==myNameLower));
  const availableColors = shuffle(COLORS.map((c,i)=>i).filter(i=>i!==state.me.color));

  const players = [];
  players.push({
    id:'me', name: state.me.name, colorIdx: state.me.color, suit: state.me.suit,
    hat: state.me.hat, visor: state.me.visor, isBot:false, isImpostor:false, alive:true,
    x: WAITING_SPAWN.x, y: WAITING_SPAWN.y, killCd:0,
  });
  for(let i=0;i<cap-1;i++){
    const name = availableNames[i % availableNames.length] || ('Oyuncu'+i);
    const colorIdx = availableColors[i] !== undefined ? availableColors[i] : Math.floor(Math.random()*COLORS.length);
    players.push({
      id:'bot'+i, name, colorIdx, suit: pick(SUITS), hat: pick(HATS_RAW),
      visor: pick(VISORS), isBot:true, isImpostor:false, alive:true,
      x: WAITING_SPAWN.x - 300, y: WAITING_SPAWN.y,
      arrived: false, arriveAt: rand(1.5, 7),
      dir: rand(0, Math.PI*2), nextTurn: rand(1,3), speed: rand(BOT_SPEED_MIN,BOT_SPEED_MAX),
      killCd: rand(10,22), sabCd: rand(15,35),
      target: null, path: null, pathIndex: 0, workTimer: 0,
    });
  }
  const idxs = shuffle(players.map((_,i)=>i)).slice(0, impCount);
  idxs.forEach(i=> players[i].isImpostor = true);

  if(state.cheat.forceRole==='impostor' && !players[0].isImpostor){
    const swapIdx = idxs.length ? idxs[0] : 1;
    players[0].isImpostor = true;
    players[swapIdx].isImpostor = false;
  } else if(state.cheat.forceRole==='crewmate' && players[0].isImpostor){
    players[0].isImpostor = false;
    const nonImp = players.findIndex((pl,i)=> i!==0 && !pl.isImpostor);
    if(nonImp>=0) players[nonImp].isImpostor = true;
  }

  state.players = players;
  state.bodies = [];
  state.taskState = {};
  assignPersonalTasks();
  state.killCooldownMax = state.settings.killCd;
  state.killCooldown = 0;
  state.gameOver = null;
  state.meetingOpen = false;
  state.currentInteract = null;
  state.activeTask = null;
  state.doorLocks = {};
  state.lightsOff = false;
  state.lightsOffUntil = 0;
  state.lightsCooldown = 0;
  state.doorsCooldown = 0;
  state.meetingVote = undefined;
  state.meetingVotesCast = {};
  state.meetingBotVoted = new Set();
  (state.meetingBotTimers||[]).forEach(clearTimeout);
  state.meetingBotTimers = [];
  clearInterval(meetingInterval);
}

function checkWin(){
  if(state.gameOver) return;
  if(aliveImpostors()===0){ state.gameOver='crew'; return; }
  if(aliveImpostors() >= aliveCrew()){ state.gameOver='impostor'; return; }
  const meRef = meP();
  if(meRef && !meRef.isImpostor && allCrewTasksDone()){
    state.gameOver='crew-tasks'; return;
  }
}

// ============ CHARACTER DRAWING ============
function drawCharacter(ctx, cx, cy, scale, p, opts){
  opts = opts || {};
  const color = COLORS[p.colorIdx] ? COLORS[p.colorIdx].hex : '#8D97A6';
  ctx.save();
  ctx.translate(cx, cy);
  ctx.scale(scale, scale);
  if(opts.facing === 'left'){ ctx.scale(-1, 1); }

  const walkPhase = opts.walking ? Math.sin((opts.walkT||0) * 11) : 0;
  const legSwing = walkPhase * 6;
  const bob = opts.walking ? Math.abs(Math.sin((opts.walkT||0) * 11)) * 2 : 0;
  ctx.translate(0, -bob);

  ctx.fillStyle = 'rgba(0,0,0,0.35)';
  ctx.beginPath(); ctx.ellipse(0, 34+bob, 22, 7, 0, 0, Math.PI*2); ctx.fill();

  ctx.fillStyle = shade(color,-45);
  roundRectPath(ctx, -22, -14, 16, 34, 8); ctx.fill();

  ctx.fillStyle = shade(color,-55);
  ctx.save(); ctx.translate(-9, 29); ctx.rotate(legSwing*Math.PI/180); ctx.translate(9,-29);
  roundRectPath(ctx, -14, 22, 10, 14, 4); ctx.fill();
  ctx.restore();
  ctx.save(); ctx.translate(11, 29); ctx.rotate(-legSwing*Math.PI/180); ctx.translate(-11,-29);
  roundRectPath(ctx, 6, 22, 10, 14, 4); ctx.fill();
  ctx.restore();

  ctx.fillStyle = color;
  roundRectPath(ctx, -20, -32, 40, 62, 20);
  ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,0.4)'; ctx.lineWidth = 2; ctx.stroke();

  drawSuit(ctx, p.suit, color);

  ctx.fillStyle = '#BFE9FF';
  roundRectPath(ctx, -2, -22, 26, 20, 10); ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,0.35)'; ctx.lineWidth=1.5; ctx.stroke();
  ctx.save();
  ctx.beginPath(); roundRectPath(ctx, -2, -22, 26, 20, 10); ctx.clip();
  drawVisor(ctx, p.visor);
  ctx.restore();

  if(p.hat && p.hat !== 'Yok'){ drawHat(ctx, p.hat, color); }

  ctx.restore();

  if(opts.showName){
    ctx.save();
    ctx.font = '700 13px Rubik, sans-serif';
    ctx.textAlign='center';
    let label = p.name;
    if(state.cheat && state.cheat.revealRoles && p.id!=='me'){
      label += p.isImpostor ? ' [IMP]' : ' [CREW]';
    }
    ctx.fillStyle='rgba(0,0,0,0.65)';
    ctx.fillText(label, cx+1, cy - 48*scale + 1);
    ctx.fillStyle= state.cheat && state.cheat.revealRoles && p.id!=='me' ? (p.isImpostor?'#E6484B':'#5EC8F2') : (p.alive===false ? '#8996B3' : '#EAF2FF');
    ctx.fillText(label, cx, cy - 48*scale);
    ctx.restore();
  }
}

