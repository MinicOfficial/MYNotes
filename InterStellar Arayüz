  document.getElementById(id).classList.add('active');
}
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(showToast._h);
  showToast._h = setTimeout(()=>t.classList.remove('show'), 1800);
}

function initStars(id){
  const c = document.getElementById(id);
  if(!c) return;
  function resize(){
    c.width = c.parentElement.clientWidth;
    c.height = c.parentElement.clientHeight;
  }
  resize();
  window.addEventListener('resize', resize);
  const ctx = c.getContext('2d');
  const stars = [];
  const n = 140;
  for(let i=0;i<n;i++){
    stars.push({x:Math.random(), y:Math.random(), r:Math.random()*1.6+0.3, a:Math.random()*0.6+0.3, tw:Math.random()*0.02+0.005});
  }
  function loop(){
    if(!c.isConnected){ return; }
    ctx.clearRect(0,0,c.width,c.height);
    for(const s of stars){
      s.a += s.tw;
      const alpha = 0.4 + Math.abs(Math.sin(s.a))*0.6;
      ctx.fillStyle = 'rgba(255,255,255,'+alpha+')';
      ctx.beginPath();
      ctx.arc(s.x*c.width, s.y*c.height, s.r, 0, Math.PI*2);
      ctx.fill();
    }
    requestAnimationFrame(loop);
  }
  loop();
}

function buildPills(containerId, values, activeValue, onPick, locked){
  const el = document.getElementById(containerId);
  el.innerHTML = '';
  values.forEach(v=>{
    const btn = document.createElement('div');
    btn.className = 'pill' + (v===activeValue?' active':'') + (locked?' locked':'');
    btn.textContent = v;
    if(!locked){
      btn.addEventListener('click', ()=>{ onPick(v); });
    }
    el.appendChild(btn);
  });
}
