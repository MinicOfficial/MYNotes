  for(let i=a.length-1;i>0;i--){ const j = Math.floor(Math.random()*(i+1)); const t=a[i]; a[i]=a[j]; a[j]=t; }
  return a;
}
function shade(hex, amt){
  const n = parseInt(hex.slice(1),16);
  let r=(n>>16)&255, g=(n>>8)&255, b=n&255;
  r = clamp(r+amt,0,255); g = clamp(g+amt,0,255); b = clamp(b+amt,0,255);
  return 'rgb('+r+','+g+','+b+')';
}
function roundRectPath(ctx,x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}
function rectContains(rc,x,y,radius){
  return x-radius>=rc.x && x+radius<=rc.x+rc.w && y-radius>=rc.y && y+radius<=rc.y+rc.h;
}
function isWalkable(x,y,radius,opts){
  opts = opts || {};
  for(let i=0;i<ROOMS.length;i++){
    if(rectContains(ROOMS[i],x,y,radius)) return true;
  }
  for(let i=0;i<CORRIDORS.length;i++){
    if(!opts.ignoreDoors && state.doorLocks[i] && state.doorLocks[i] > performance.now()) continue;
    if(rectContains(CORRIDORS[i],x,y,radius)) return true;
  }
  return false;
}
function roomAt(x,y){
  for(const r of ROOMS){ if(x>=r.x && x<=r.x+r.w && y>=r.y && y<=r.y+r.h) return r.label; }
  return 'Koridor';
}

// ============ BOT PATHFINDING ============
const PATH_CELL = 40;
const PATH_COLS = Math.ceil(WORLD_W/PATH_CELL);
const PATH_ROWS = Math.ceil(WORLD_H/PATH_CELL);
let PATH_GRID = null;
function buildPathGrid(){
  PATH_GRID = new Uint8Array(PATH_COLS*PATH_ROWS);
  for(let ry=0; ry<PATH_ROWS; ry++){
    for(let rx=0; rx<PATH_COLS; rx++){
      const cx = rx*PATH_CELL + PATH_CELL/2;
      const cy = ry*PATH_CELL + PATH_CELL/2;
      PATH_GRID[ry*PATH_COLS+rx] = isWalkable(cx,cy,R,{ignoreDoors:true}) ? 1 : 0;
    }
  }
}
function clampInt(v,a,b){ return Math.max(a, Math.min(b, v|0)); }
function nearestWalkableCell(cx,cy){
  if(PATH_GRID[cy*PATH_COLS+cx]) return [cx,cy];
  for(let rad=1; rad<8; rad++){
    for(let dy=-rad; dy<=rad; dy++){
      for(let dx=-rad; dx<=rad; dx++){
        const nx=cx+dx, ny=cy+dy;
        if(nx<0||ny<0||nx>=PATH_COLS||ny>=PATH_ROWS) continue;
        if(PATH_GRID[ny*PATH_COLS+nx]) return [nx,ny];
      }
    }
  }
  return [cx,cy];
}
function findPathTo(fromX,fromY,toX,toY){
  const sx0 = clampInt(Math.floor(fromX/PATH_CELL),0,PATH_COLS-1);
  const sy0 = clampInt(Math.floor(fromY/PATH_CELL),0,PATH_ROWS-1);
  const tx0 = clampInt(Math.floor(toX/PATH_CELL),0,PATH_COLS-1);
  const ty0 = clampInt(Math.floor(toY/PATH_CELL),0,PATH_ROWS-1);
  const [sx,sy] = nearestWalkableCell(sx0,sy0);
  const [tx,ty] = nearestWalkableCell(tx0,ty0);
  const startIdx = sy*PATH_COLS+sx, targetIdx = ty*PATH_COLS+tx;
  if(startIdx===targetIdx) return [{x:toX,y:toY}];
  const visited = new Int32Array(PATH_COLS*PATH_ROWS).fill(-1);
  visited[startIdx] = startIdx;
  let queue = [startIdx], qi = 0, found = false;
  while(qi<queue.length){
    const cur = queue[qi++];
    if(cur===targetIdx){ found=true; break; }
    const cx = cur % PATH_COLS, cy = (cur / PATH_COLS)|0;
    const neigh = [[cx+1,cy],[cx-1,cy],[cx,cy+1],[cx,cy-1]];
    for(const [nx,ny] of neigh){
      if(nx<0||ny<0||nx>=PATH_COLS||ny>=PATH_ROWS) continue;
      const nIdx = ny*PATH_COLS+nx;
      if(visited[nIdx]!==-1 || !PATH_GRID[nIdx]) continue;
      visited[nIdx] = cur;
      queue.push(nIdx);
    }
  }
  if(!found) return [{x:toX,y:toY}];
  const cellsPath = [];
  let cur = targetIdx;
  while(cur!==startIdx){ cellsPath.push(cur); cur = visited[cur]; }
  cellsPath.reverse();
  const waypoints = cellsPath.map(idx=>{
    const cx = idx % PATH_COLS, cy = (idx / PATH_COLS)|0;
    return {x: cx*PATH_CELL+PATH_CELL/2, y: cy*PATH_CELL+PATH_CELL/2};
  });
  waypoints.push({x:toX,y:toY});
  return waypoints;
}

