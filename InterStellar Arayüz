function startWaitingRoomLoop(){
  state.lastTs = performance.now();
  state.waitRunId = (state.waitRunId||0) + 1;
  const myRunId = state.waitRunId;
  let timeLeft = 16;
  showBotProfileCard(meP());
  document.getElementById('roleChip').textContent = 'BEKLEME YERİ';
  document.getElementById('roleChip').className = 'chip';
  document.getElementById('taskChip').textContent = 'Oyun başlıyor: ' + timeLeft + 's';
  document.getElementById('btnKill').style.display='none';
  document.getElementById('btnSabLights').style.display='none';
  document.getElementById('btnSabDoors').style.display='none';
  document.getElementById('btnInteract').style.display='none';
  const countdown = setInterval(()=>{
    if(state.waitRunId !== myRunId){ clearInterval(countdown); return; }
    timeLeft--;
    document.getElementById('taskChip').textContent = 'Oyun başlıyor: ' + Math.max(timeLeft,0) + 's';
    if(timeLeft<=0){
      clearInterval(countdown);
      state.inWaitingRoom = false;
      state.players.forEach(pl=>{ pl.x = SPAWN.x + rand(-60,60); pl.y = SPAWN.y + rand(-40,40); pl.arrived = true; pl.target=null; pl.path=null; pl.workTimer=0; });
      document.getElementById('btnInteract').style.display='block';
      showRoleScreen();
    }
  }, 1000);
  let elapsed = 0;
  function waitTick(ts){
    if(state.waitRunId !== myRunId) return;
    const dt = Math.min(0.05, (ts - state.lastTs)/1000 || 0);
    state.lastTs = ts;
    elapsed += dt;
    if(state.inWaitingRoom){
      updatePlayer(dt);
      updateBotsWander(dt, elapsed);
      render();
      requestAnimationFrame(waitTick);
    }
  }
  requestAnimationFrame(waitTick);
}
function updateBotsWander(dt, elapsed){
  for(const b of state.players){
    if(!b.isBot) continue;
    if(!b.arrived){
      if(elapsed >= b.arriveAt){
        b.arrived = true;
        b.x = WAITING_SPAWN.x + rand(-40,40);
        b.y = WAITING_SPAWN.y + rand(-30,30);
        showBotProfileCard(b);
      } else { continue; }
    }
    if(!b.target || !b.path){
      b.target = {x: WAITING_SPAWN.x + rand(-220,220), y: WAITING_SPAWN.y + rand(-160,160)};
      b.path = findPathTo(b.x, b.y, b.target.x, b.target.y);
      b.pathIndex = 0;
    }
    const wp = b.path[b.pathIndex];
    const ddx = wp.x-b.x, ddy = wp.y-b.y;
    const dd = Math.hypot(ddx,ddy);
    if(dd < 14){
      b.pathIndex++;
      if(b.pathIndex >= b.path.length){ b.target=null; b.path=null; }
    } else {
      const ux=ddx/dd, uy=ddy/dd;
      b.x += ux*b.speed*dt; b.y += uy*b.speed*dt;
      if(Math.abs(ux)>0.15) b.facing = ux<0?'left':'right';
      b.walking = true; b.walkT = (b.walkT||0)+dt;
    }
  }
}

