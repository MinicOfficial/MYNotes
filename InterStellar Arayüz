function renderCameraView(){
  const cam = CAMERAS[state.cameraIndex];
  document.getElementById('cameraLabel').textContent = cam.label;
  const canvasEl = document.getElementById('cameraCanvas');
  const cctx = canvasEl.getContext('2d');
  cctx.fillStyle = '#0A0F1E'; cctx.fillRect(0,0,canvasEl.width,canvasEl.height);
  cctx.strokeStyle = '#3ED598'; cctx.lineWidth = 2;
  cctx.strokeRect(2,2,canvasEl.width-4,canvasEl.height-4);
  const scale = 0.35;
  const ox = cam.x - canvasEl.width/(2*scale);
  const oy = cam.y - canvasEl.height/(2*scale);
  state.players.filter(p=>p.alive).forEach(p=>{
    const px = (p.x-ox)*scale, py = (p.y-oy)*scale;
    if(px<0||px>canvasEl.width||py<0||py>canvasEl.height) return;
    cctx.fillStyle = COLORS[p.colorIdx].hex;
    cctx.beginPath(); cctx.arc(px,py,6,0,Math.PI*2); cctx.fill();
  });
}

