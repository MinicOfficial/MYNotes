const BOT_ACCUSE_LINES = [
  'bence {name} impostor',
  '{name} çok şüpheli davranıyordu',
  '{name} nerede olduğunu söylesin',
  'ben görevimi yaptım, {name} ne yaptı?',
  '{name} ile aynı odadaydım, tuhaf davrandı',
  'kimse {name}\'i görmedi değil mi?',
  '{name} beni öldürmeye çalıştı sanki',
  'emin değilim ama {name} olabilir',
];
const BOT_DEFEND_LINES = ['ben yapmadım', 'görevimi yapıyordum', 'suçsuzum', 'kanıt yok ki', 'bunu kanıtlayamazsınız'];
function scheduleBotChat(){
  (state.meetingChatTimers||[]).forEach(clearTimeout);
  const alivePlayers = state.players.filter(p=>p.alive);
  const botChatters = alivePlayers.filter(p=>p.isBot);
  state.meetingChatTimers = botChatters.filter(()=>Math.random()<0.7).map(bot=>{
    const delayMs = rand(1500, 15000);
    return setTimeout(()=>{
      if(!state.meetingOpen) return;
      const others = alivePlayers.filter(p=>p.id!==bot.id);
      let text;
      if(Math.random()<0.6 && others.length){
        text = pick(BOT_ACCUSE_LINES).replace('{name}', pick(others).name);
      } else {
        text = pick(BOT_DEFEND_LINES);
      }
      addChatLine(bot, text, false);
    }, delayMs);
  });
}
function scheduleBotVotes(){
  (state.meetingBotTimers||[]).forEach(clearTimeout);
  const alivePlayers = state.players.filter(p=>p.alive);
  const botVoters = alivePlayers.filter(p=>p.isBot);
  state.meetingBotTimers = botVoters.map(bot=>{
    const delayMs = rand(4000, 17000);
    return setTimeout(()=>{ castBotVote(bot); }, delayMs);
  });
}
function castBotVote(bot){
  if(!state.meetingOpen || !bot.alive) return;
  const alivePlayers = state.players.filter(p=>p.alive);
  let targetId = null;
  const roll = Math.random();
  if(bot.isImpostor){
    const crewTargets = alivePlayers.filter(x=>!x.isImpostor);
    if(roll < 0.75 && crewTargets.length){ targetId = pick(crewTargets).id; }
  } else {
    if(roll < 0.8){
      const targets = alivePlayers.filter(x=>x.id!==bot.id);
      if(targets.length) targetId = pick(targets).id;
    }
  }
  state.meetingVotesCast[bot.id] = targetId;
  state.meetingBotVoted.add(bot.id);
  renderVoteList();
}
function renderVoteList(){
  const list = document.getElementById('voteList');
  list.innerHTML = '';
  const alivePlayers = state.players.filter(p=>p.alive);
  alivePlayers.forEach(p=>{
    const row = document.createElement('div');
    row.className = 'vote-row';
    const dot = document.createElement('div');
    dot.className = 'dot';
    dot.style.background = COLORS[p.colorIdx].hex;
    const nm = document.createElement('div');
    nm.className = 'nm';
    nm.textContent = p.name + (p.id==='me' ? ' (Sen)' : '');
    row.appendChild(dot); row.appendChild(nm);
    if(p.id !== 'me'){
      if(state.meetingBotVoted && state.meetingBotVoted.has(p.id)){
        const tag = document.createElement('span');
        tag.className = 'dead-tag';
        tag.textContent = 'oy kullandı';
        row.appendChild(tag);
      }
      const btn = document.createElement('button');
      btn.textContent = state.meetingVote===p.id ? 'OY VERDİN' : 'OY VER';
      if(state.meetingVote===p.id) btn.classList.add('chosen');
      btn.addEventListener('click', ()=>{ state.meetingVote = p.id; renderVoteList(); });
      row.appendChild(btn);
    }
    list.appendChild(row);
  });
  const skipBtn = document.getElementById('btnSkipVote');
  skipBtn.classList.toggle('chosen', state.meetingVote===null);
  skipBtn.textContent = state.meetingVote===null ? 'OYU GEÇTİN' : 'OYU GEÇ';
}
document.addEventListener('DOMContentLoaded', ()=>{
  document.getElementById('btnSkipVote').addEventListener('click', ()=>{
    state.meetingVote = null;
    renderVoteList();
  });
  function sendChat(){
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if(!text || !state.meetingOpen) return;
    addChatLine(meP(), text, false);
    input.value = '';
  }
  document.getElementById('btnChatSend').addEventListener('click', sendChat);
  document.getElementById('chatInput').addEventListener('keydown', (e)=>{
    if(e.key==='Enter') sendChat();
  });
});
function startMeetingTimer(){
  let t = 30;
  const timerEl = document.getElementById('meetingTimer');
  timerEl.textContent = t;
  clearInterval(meetingInterval);
  meetingInterval = setInterval(()=>{
    t -= 1;
    timerEl.textContent = Math.max(t,0);
    if(t<=0){
      clearInterval(meetingInterval);
      finalizeMeeting();
    }
  }, 1000);
}
function finalizeMeeting(){
  (state.meetingBotTimers||[]).forEach(clearTimeout);
  state.meetingBotTimers = [];
  (state.meetingChatTimers||[]).forEach(clearTimeout);
  state.meetingChatTimers = [];
  document.getElementById('overlayMeeting').classList.remove('active');
  const alivePlayers = state.players.filter(p=>p.alive);
  const tally = {};
  const registerVote = (id)=>{ if(id) tally[id] = (tally[id]||0)+1; };
  registerVote(state.meetingVote);
  alivePlayers.forEach(p=>{
    if(p.id==='me') return;
    let targetId = state.meetingVotesCast[p.id];
    if(targetId === undefined){
      const roll = Math.random();
      if(p.isImpostor){
        const crewTargets = alivePlayers.filter(x=>!x.isImpostor);
        targetId = (roll < 0.75 && crewTargets.length) ? pick(crewTargets).id : null;
      } else {
        const targets = alivePlayers.filter(x=>x.id!==p.id);
        targetId = (roll < 0.8 && targets.length) ? pick(targets).id : null;
      }
    }
    registerVote(targetId);
  });
  let ejectedId = null, max = 0, tie=false;
  Object.keys(tally).forEach(id=>{
    if(tally[id] > max){ max = tally[id]; ejectedId = id; tie=false; }
    else if(tally[id] === max){ tie = true; }
  });
  if(tie) ejectedId = null;

  const resultTitle = document.getElementById('resultTitle');
  const resultDesc = document.getElementById('resultDesc');
  if(!ejectedId){
    resultTitle.textContent = 'Kimse Atılmadı';
    resultDesc.textContent = 'Oylar dağıldı, kimse gemiden atılmadı.';
  } else {
    const ejected = state.players.find(p=>p.id===ejectedId);
    ejected.alive = false;
    if(ejected.id==='me') onPlayerDied();
    resultTitle.textContent = ejected.name + ' Atıldı';
    resultDesc.textContent = ejected.name + ' bir ' + (ejected.isImpostor ? 'IMPOSTOR' : 'CREWMATE') + ' idi.';
  }
  document.getElementById('overlayResult').classList.add('active');
}
