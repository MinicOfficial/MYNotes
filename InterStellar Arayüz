<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>StarStellar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800;900&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#080B14; --bg2:#0D1220; --panel:#121A2E; --panel2:#0F1626;
    --border:#26365C; --border-soft:#1B2745;
    --accent:#FFC857; --accent-dim:#C99A3D; --accent-ink:#251A02;
    --crew:#5EC8F2; --imp:#E6484B;
    --text:#EAF2FF; --muted:#8996B3;
    --ok:#3ED598;
    --radius: 14px;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  :root:not([data-theme="light"]){
    --bg:#080B14; --panel:#121A2E; --text:#EAF2FF;
  }
  :root[data-theme="dark"]{
    --bg:#080B14; --panel:#121A2E; --text:#EAF2FF;
  }
  *{box-sizing:border-box;}
  html,body{
    height:100%; margin:0; background:var(--bg); color:var(--text);
    font-family:'Rubik',system-ui,sans-serif; overflow:hidden;
    -webkit-tap-highlight-color: transparent; user-select:none;
  }
  html{ scroll-padding-top: env(safe-area-inset-top, 0px); }
  h1,h2,h3, .display{ font-family:'Orbitron', sans-serif; letter-spacing:0.02em; }
  #app{ position:fixed; inset:0; }
  .screen{
    position:absolute; inset:0; display:none;
    flex-direction:column; align-items:center; justify-content:center;
    padding: 24px 16px;
    background:
      radial-gradient(1100px 700px at 18% -10%, #16224a55, transparent 60%),
      radial-gradient(900px 600px at 100% 110%, #0d2a3055, transparent 60%),
      var(--bg);
  }
  .screen.active{ display:flex; }
  .stars-bg{ position:absolute; inset:0; pointer-events:none; opacity:.55; }

  /* ---------- START SCREEN ---------- */
  #screen-start .logo-wrap{ text-align:center; margin-bottom:46px; }
  #screen-start h1{
    font-size: clamp(2.6rem, 9vw, 4.6rem); margin:0; font-weight:900;
    color: var(--text);
    text-shadow: 0 0 26px #FFC85766, 0 0 2px #fff;
    letter-spacing: 0.06em;
  }
  #screen-start h1 span{ color: var(--accent); }
  #screen-start .tagline{ color:var(--muted); margin-top:10px; font-size:.95rem; letter-spacing:.08em; }
  .btn-primary{
    font-family:'Orbitron',sans-serif; font-weight:700; font-size:1.05rem;
    background: linear-gradient(180deg, #FFD874, var(--accent));
    color: var(--accent-ink); border:none; border-radius: 10px;
    padding: 18px 44px; cursor:pointer; letter-spacing:.06em;
    box-shadow: 0 6px 0 var(--accent-dim), 0 10px 24px #FFC85744;
    transition: transform .08s ease;
  }
  .btn-primary:active{ transform: translateY(4px); box-shadow: 0 2px 0 var(--accent-dim); }
  .btn-ghost{
    font-family:'Rubik',sans-serif; font-weight:600; background:transparent;
    color:var(--muted); border:1px solid var(--border); border-radius:10px;
    padding:12px 22px; cursor:pointer;
  }
  .btn-ghost:hover{ color:var(--text); border-color: var(--accent-dim); }

  /* ---------- PANEL ---------- */
  .panel{
    width:100%; max-width:560px; background:var(--panel);
    border:1px solid var(--border); border-radius: var(--radius);
    padding: 26px 24px; box-shadow: 0 20px 50px #00000066;
  }
  .panel h2{ margin:0 0 4px; font-size:1.3rem; }
  .panel .sub{ color:var(--muted); font-size:.85rem; margin-bottom:20px; }
  .field{ margin-bottom:18px; }
  .field label{ display:block; font-size:.78rem; color:var(--muted); margin-bottom:8px; letter-spacing:.04em; }
  .pills{ display:flex; flex-wrap:wrap; gap:8px; }
  .pill{
    padding:9px 16px; border-radius:999px; border:1px solid var(--border);
    background:var(--panel2); color:var(--text); cursor:pointer; font-size:.9rem;
    font-weight:500; transition: all .1s ease;
  }
  .pill:hover{ border-color:var(--accent-dim); }
  .pill.active{ background:var(--accent); color:var(--accent-ink); border-color:var(--accent); font-weight:700; }
  .pill.locked{ cursor:default; }
  .row-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:22px; }

  /* ---------- WAITING / CUSTOMIZE ---------- */
  #screen-waiting .customize-wrap{
    display:flex; gap:28px; width:100%; max-width:920px; align-items:flex-start;
    flex-wrap:wrap; justify-content:center;
  }
  .preview-card{
    background:var(--panel); border:1px solid var(--border); border-radius:var(--radius);
    padding:18px; text-align:center; width:230px; flex-shrink:0;
  }
  .preview-card canvas{ background:radial-gradient(circle at 50% 35%, #1c2947, #0c1120); border-radius:10px; }
  .preview-name{ margin-top:10px; font-weight:700; font-family:'Orbitron',sans-serif; font-size:.95rem; }
  .cust-panel{
    background:var(--panel); border:1px solid var(--border); border-radius:var(--radius);
    padding:20px; flex:1; min-width:300px; max-width:560px;
  }
  .swatches{ display:grid; grid-template-columns:repeat(8,1fr); gap:8px; }
  .swatch{
    width:100%; aspect-ratio:1; border-radius:8px; cursor:pointer;
    border:2px solid transparent; position:relative;
  }
  .swatch.active{ border-color:#fff; box-shadow:0 0 0 2px var(--accent); }
  .opt-scroll{ display:flex; gap:8px; overflow-x:auto; padding-bottom:4px; }
  .opt-scroll .pill{ white-space:nowrap; }
  .name-input{
    width:100%; padding:11px 14px; border-radius:10px; border:1px solid var(--border);
    background:var(--panel2); color:var(--text); font-size:.95rem; font-family:'Rubik',sans-serif;
  }
  .name-input:focus{ outline:none; border-color:var(--accent); }

  /* ---------- ROLE SCREEN ---------- */
  #screen-role .role-card{ text-align:center; }
  #screen-role .role-label{ color:var(--muted); font-size:.9rem; letter-spacing:.14em; margin-bottom:14px; }
  #screen-role .role-name{ font-size: clamp(2rem,8vw,3.4rem); font-weight:900; margin:0 0 18px; }
  #screen-role .role-name.crew{ color:var(--crew); text-shadow:0 0 30px #5EC8F266; }
  #screen-role .role-name.imp{ color:var(--imp); text-shadow:0 0 30px #E6484B66; }
  #screen-role .role-desc{ color:var(--muted); max-width:420px; margin:0 auto 26px; line-height:1.5; font-size:.92rem; }

  /* ---------- GAME SCREEN ---------- */
  #screen-game{ padding:0; }
  #gameCanvas{ display:block; width:100%; height:100%; background:#04060c; touch-action:none; }
  .hud{ position:absolute; inset:0; pointer-events:none; }
  .hud > *{ pointer-events:auto; }
  .hud-top{
    position:absolute; top: calc(14px + env(safe-area-inset-top,0px)); left:14px; right:14px;
    display:flex; justify-content:space-between; align-items:flex-start; gap:10px;
    pointer-events:none;
  }
  .chip{
    background:#0D1220cc; border:1px solid var(--border); border-radius:10px;
    padding:8px 12px; font-size:.78rem; backdrop-filter: blur(6px);
  }
  .chip.role-crew{ color:var(--crew); border-color:#5EC8F255; }
  .chip.role-imp{ color:var(--imp); border-color:#E6484B55; }
  .chip .room-name{ font-family:'Orbitron',sans-serif; font-weight:700; font-size:.85rem; color:var(--text); }
  #promptChip{
    position:absolute; left:50%; bottom: calc(160px + env(safe-area-inset-bottom,0px)); transform:translateX(-50%);
    background:#FFC857; color:var(--accent-ink); font-weight:700; font-size:.85rem;
    padding:9px 16px; border-radius:999px; display:none; white-space:nowrap;
    box-shadow:0 8px 18px #00000055;
  }
  .dpad{
    position:absolute; left: calc(18px + env(safe-area-inset-left,0px)); bottom: calc(18px + env(safe-area-inset-bottom,0px));
    width:150px; height:150px;
  }
  .dpad button{
    position:absolute; width:50px; height:50px; border-radius:12px; border:1px solid var(--border);
    background:#0D1220cc; color:var(--text); font-size:1.2rem; backdrop-filter: blur(6px);
  }
  .dpad button:active{ background:var(--accent); color:var(--accent-ink); }
  .dpad .up{ top:0; left:50px; } .dpad .down{ bottom:0; left:50px; }
  .dpad .left{ top:50px; left:0; } .dpad .right{ top:50px; right:0; }
  .action-cluster{
    position:absolute; right: calc(18px + env(safe-area-inset-right,0px)); bottom: calc(18px + env(safe-area-inset-bottom,0px));
    display:flex; flex-direction:column; gap:12px; align-items:flex-end;
  }
  .round-btn{
    width:74px; height:74px; border-radius:50%; border:2px solid var(--border);
    background:#0D1220dd; color:var(--text); font-family:'Orbitron',sans-serif; font-weight:700;
    font-size:.78rem; backdrop-filter: blur(6px);
  }
  .round-btn.interact{ border-color: var(--accent); color:var(--accent); }
  .round-btn.interact.ready{ background: var(--accent); color:var(--accent-ink); }
  .round-btn.kill{ border-color: var(--imp); color:var(--imp); width:60px; height:60px; font-size:.7rem; }
  .round-btn.kill.ready{ background: var(--imp); color:#fff; }
  .round-btn.sab{ border-color: #B98CFF; color:#B98CFF; width:56px; height:56px; font-size:.62rem; }
  .round-btn.sab.ready{ background:#B98CFF; color:#1a0d33; }
  .round-btn:disabled{ opacity:.35; }
  .ghost-chip{ color:#B7C6E8 !important; border-color:#B7C6E855 !important; }
  #lightsOverlay{
    position:absolute; inset:0; pointer-events:none; z-index:5; display:none;
    background: radial-gradient(circle 160px at var(--vx,50%) var(--vy,50%), transparent 0%, transparent 55%, #000000e6 88%);
  }
  #lightsOverlay.active{ display:block; }

  /* ---------- OVERLAYS ---------- */
  .overlay{
    position:absolute; inset:0; background:#02040acc; backdrop-filter: blur(3px);
    display:none; align-items:center; justify-content:center; z-index:20; padding:16px;
  }
  .overlay.active{ display:flex; }
  .overlay-card{
    background:var(--panel); border:1px solid var(--border); border-radius:var(--radius);
    padding:24px; width:100%; max-width:460px; max-height:86vh; overflow-y:auto;
  }
  .overlay-card h3{ margin:0 0 4px; }
  .overlay-card .sub{ color:var(--muted); font-size:.85rem; margin-bottom:16px; }
  .vote-list{ display:flex; flex-direction:column; gap:8px; margin-bottom:16px; }
  .vote-row{
    display:flex; align-items:center; gap:10px; background:var(--panel2);
    border:1px solid var(--border-soft); border-radius:10px; padding:9px 12px;
  }
  .vote-row .dot{ width:22px; height:22px; border-radius:6px; flex-shrink:0; border:1px solid #ffffff33; }
  .vote-row .nm{ flex:1; font-weight:600; font-size:.9rem; }
  .vote-row .dead-tag{ color:var(--muted); font-size:.72rem; }
  .vote-row button{
    font-family:'Rubik',sans-serif; font-weight:600; font-size:.78rem;
    background:transparent; border:1px solid var(--border); color:var(--text);
    border-radius:8px; padding:6px 12px; cursor:pointer;
  }
  .vote-row button:hover{ border-color:var(--accent); color:var(--accent); }
  .vote-row button:disabled{ opacity:.3; }
  .vote-row button.chosen{ background:var(--accent); color:var(--accent-ink); border-color:var(--accent); }
  .skip-btn{ width:100%; }
  .skip-btn.chosen{ border-color:var(--accent); color:var(--accent); }
  .meeting-timer{
    font-family:'Orbitron',sans-serif; font-weight:800; font-size:1.6rem; color:var(--accent);
    text-align:center; margin-bottom:14px; letter-spacing:.05em;
  }
  .chat-log{
    max-height:160px; overflow-y:auto; display:flex; flex-direction:column; gap:6px;
    margin-bottom:10px; padding:8px; background:var(--panel2); border-radius:10px;
    border:1px solid var(--border-soft);
  }
  .chat-line{ font-size:.82rem; line-height:1.4; }
  #profileCard{
    position:absolute; left:50%; top: calc(70px + env(safe-area-inset-top,0px));
    transform:translateX(-50%); display:flex; align-items:center; gap:10px;
    background:#0D1220ee; border:1px solid var(--border); border-radius:12px;
    padding:8px 14px; max-width:280px; z-index:8;
  }
  #profileCard canvas{ flex-shrink:0; }
  #profileCard .pc-text{ display:flex; flex-direction:column; }
  #profileCard .pc-name{ font-weight:700; font-size:.82rem; font-family:'Orbitron',sans-serif; }
  #profileCard .pc-line{ font-size:.75rem; color:var(--muted); margin-top:2px; }
  .chat-line .who{ font-weight:700; margin-right:4px; }
  .chat-input-row{ display:flex; gap:8px; margin-bottom:14px; }
  .chat-input-row input{
    flex:1; padding:9px 12px; border-radius:8px; border:1px solid var(--border);
    background:var(--panel2); color:var(--text); font-size:.85rem; font-family:'Rubik',sans-serif;
  }
  .chat-input-row input:focus{ outline:none; border-color:var(--accent); }
  .chat-input-row button{
    font-family:'Rubik',sans-serif; font-weight:700; font-size:.8rem;
    background:var(--accent); color:var(--accent-ink); border:none; border-radius:8px;
    padding:9px 14px; cursor:pointer;
  }
  .room-pick-list{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
  .task-progress-wrap{ margin:18px 0; }
  .bar-track{ height:16px; background:var(--panel2); border-radius:999px; overflow:hidden; border:1px solid var(--border-soft); }
  .bar-fill{ height:100%; width:0%; background:linear-gradient(90deg,var(--ok),#69f2b8); }
  .hold-btn{
    width:100%; padding:22px; margin-top:14px; border-radius:12px; border:1px dashed var(--border);
    background:var(--panel2); color:var(--text); font-weight:700; font-family:'Orbitron',sans-serif;
    font-size:.85rem; cursor:pointer;
  }
  .click-count{ font-family:'Orbitron',sans-serif; font-size:2.2rem; text-align:center; margin:10px 0; color:var(--accent); }
  .toast{
    position:absolute; top: calc(70px + env(safe-area-inset-top,0px)); left:50%; transform:translateX(-50%);
    background:#0D1220ee; border:1px solid var(--ok); color:var(--ok); padding:9px 18px;
    border-radius:10px; font-size:.85rem; font-weight:600; opacity:0; transition:opacity .25s ease; z-index:30;
    pointer-events:none; white-space:nowrap;
  }
  .toast.show{ opacity:1; }
  .end-title{ font-size:2rem; margin:0 0 8px; text-align:center; }
  .end-title.win{ color:var(--ok); } .end-title.lose{ color:var(--imp); }
  .end-desc{ text-align:center; color:var(--muted); margin-bottom:22px; }

  ::-webkit-scrollbar{ width:8px; } ::-webkit-scrollbar-thumb{ background:var(--border); border-radius:8px; }

  @media (max-width: 480px){
    .customize-wrap{ flex-direction:column; align-items:center; }
    .preview-card{ width:100%; max-width:230px; }
  }
</style>
</head>
<body>
<div id="app">

  <!-- START -->
  <div class="screen active" id="screen-start">
    <canvas class="stars-bg" id="starsStart"></canvas>
    <div class="logo-wrap">
      <h1>Star<span>Stellar</span></h1>
      <div class="tagline">GEMİDE KİM İHANET EDİYOR?</div>
    </div>
    <button class="btn-primary" id="btn-new-game">YENİ OYUN</button>
    <button class="btn-ghost" id="btn-how-to-play" style="margin-top:14px;">NASIL OYNANIR</button>
    <button class="btn-ghost" id="btn-codes" style="margin-top:10px; font-size:.75rem; padding:8px 16px; opacity:.6;">KODLAR</button>
  </div>

  <!-- HOW TO PLAY -->
  <div class="screen" id="screen-howto">
    <canvas class="stars-bg" id="starsHowto"></canvas>
    <div class="panel" style="max-width:600px; max-height:80vh; overflow-y:auto;">
      <h2>Nasıl Oynanır</h2>
      <div class="sub">Kurallar ve kontroller</div>
      <div style="font-size:.9rem; line-height:1.7; color:var(--text);">
        <h3 style="font-size:1rem; color:var(--accent); margin-bottom:6px;">Amaç</h3>
        <p style="margin-top:0; color:var(--muted);">Mürettebat (Crewmate) tüm görevleri tamamlayarak ya da aranızdaki impostor(lar)ı toplantılarda oylayarak kazanır. Impostor ise mürettebatı fark ettirmeden birer birer etkisiz hale getirerek kazanır.</p>
        <h3 style="font-size:1rem; color:var(--accent); margin-bottom:6px;">Kontroller</h3>
        <p style="margin-top:0; color:var(--muted);">Sol alttaki ok tuşları (veya WASD) ile hareket edersin. Sağ alttaki E butonu ile görev yapma, ceset bildirme ve acil toplantı başlatma gibi etkileşimleri gerçekleştirirsin.</p>
        <h3 style="font-size:1rem; color:var(--accent); margin-bottom:6px;">Crewmate</h3>
        <p style="margin-top:0; color:var(--muted);">Haritadaki görevleri tamamla. Bir ceset bulursan bildir, şüphelendiğin kişileri toplantılarda oyla.</p>
        <h3 style="font-size:1rem; color:var(--accent); margin-bottom:6px;">Impostor</h3>
        <p style="margin-top:0; color:var(--muted);">Kimliğini gizleyerek mürettebatı öldür. Işıkları kesip kapıları kilitleyerek sabotaj yapabilirsin. Sahte görev yaparak şüpheyi üzerinden atabilirsin.</p>
      </div>
      <div class="row-actions">
        <button class="btn-primary" id="btn-howto-back" style="padding:12px 28px; font-size:.9rem;">GERİ DÖN</button>
      </div>
    </div>
  </div>

  <!-- CODES SCREEN -->
  <div class="screen" id="screen-codes">
    <canvas class="stars-bg" id="starsCodes"></canvas>
    <div class="panel">
      <h2>Kodlar</h2>
      <div class="sub">Bir kod biliyorsan aşağıya yaz.</div>
      <div class="field">
        <label>Kod</label>
        <input type="text" id="codeInput" class="name-input" maxlength="20" placeholder="Kodu yaz..." style="text-transform:uppercase;">
      </div>
      <div class="row-actions">
        <button class="btn-ghost" id="btn-codes-back">Geri</button>
        <button class="btn-primary" id="btn-codes-submit" style="padding:12px 28px; font-size:.9rem;">GÖNDER</button>
      </div>
    </div>
  </div>

  <!-- CHEAT SCREEN -->
  <div class="screen" id="screen-cheat">
    <canvas class="stars-bg" id="starsCheat"></canvas>
    <div class="panel">
      <h2>Hile Menüsü</h2>
      <div class="sub">Bir sonraki oyun için geçerli olacak ayarlar.</div>
      <div class="field">
        <label>Rol Zorlama</label>
        <div class="pills" id="pillsCheatRole"></div>
      </div>
      <div class="field">
        <label>Diğer</label>
        <div class="pills" id="pillsCheatReveal"></div>
      </div>
      <div class="row-actions">
        <button class="btn-ghost" id="btn-cheat-back">Geri</button>
      </div>
    </div>
  </div>

  <!-- MODE SELECT -->
  <div class="screen" id="screen-modeselect">
    <canvas class="stars-bg" id="starsMode"></canvas>
    <div class="panel" style="text-align:center;">
      <h2>Oyun Modu</h2>
      <div class="sub">Nasıl oynamak istersin?</div>
      <div style="display:flex; flex-direction:column; gap:12px; margin-top:10px;">
        <button class="btn-primary" id="btn-mode-single" style="padding:16px;">TEK OYUNCULU</button>
        <button class="btn-ghost" id="btn-mode-multi" style="padding:16px; opacity:.6;">ÇOK OYUNCULU<br><span style="font-size:.72rem;">Yakında gelecek!</span></button>
      </div>
      <div class="row-actions" style="justify-content:center; margin-top:18px;">
        <button class="btn-ghost" id="btn-modeselect-back">Geri</button>
      </div>
    </div>
  </div>

  <!-- LOBBY -->
  <div class="screen" id="screen-lobby">
    <canvas class="stars-bg" id="starsLobby"></canvas>
    <div class="panel">
      <h2>Sunucu Ayarları</h2>
      <div class="sub">Katılmak istediğin sunucuyu yapılandır.</div>

      <div class="field">
        <label>Sunucu Boyutu (Kişi Sayısı)</label>
        <div class="pills" id="pillsCapacity"></div>
      </div>
      <div class="field">
        <label>Impostor Sayısı</label>
        <div class="pills" id="pillsImpostor"></div>
      </div>
      <div class="field">
        <label>Sunucular</label>
        <div class="pills" id="pillsServerPick"></div>
      </div>
      <div class="field">
        <label>Öldürme Süresi (sn)</label>
        <div class="pills" id="pillsKillCd"></div>
      </div>

      <div class="row-actions">
        <button class="btn-ghost" id="btn-lobby-back">Geri</button>
        <button class="btn-primary" id="btn-lobby-join" style="padding:12px 28px; font-size:.9rem;">SUNUCUYA KATIL</button>
      </div>
    </div>
  </div>

  <!-- WAITING / CUSTOMIZE -->
  <div class="screen" id="screen-waiting">
    <canvas class="stars-bg" id="starsWait"></canvas>
    <div class="customize-wrap">
      <div class="preview-card">
        <canvas id="previewCanvas" width="200" height="240"></canvas>
        <div class="preview-name" id="previewName">-</div>
      </div>
      <div class="cust-panel">
        <h2 style="margin-top:0;">Bekleme Noktası</h2>
        <div class="sub">Karakterini özelleştir ve hazır olduğunda oyuna başla.</div>

        <div class="field">
          <label>İsim</label>
          <input type="text" id="nameInput" class="name-input" maxlength="18" placeholder="İsmini yaz...">
        </div>
        <div class="field">
          <label>Renk</label>
