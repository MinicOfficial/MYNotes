function onGameOver(){
  const title = document.getElementById('endTitle');
  const desc = document.getElementById('endDesc');
  const meRef = meP();
  if(state.gameOver==='crew' || state.gameOver==='crew-tasks'){
    const win = !meRef.isImpostor;
    title.textContent = win ? 'MÜRETTEBAT KAZANDI' : 'MÜRETTEBAT KAZANDI';
    title.className = 'end-title ' + (win?'win':'lose');
    desc.textContent = state.gameOver==='crew-tasks'
      ? 'Tüm görevler tamamlandı. ' + (win ? 'Kazandın!' : 'Impostor olarak kaybettin.')
      : 'Tüm impostorlar gemiden atıldı. ' + (win ? 'Kazandın!' : 'Impostor olarak kaybettin.');
  } else if(state.gameOver==='impostor'){
    const win = meRef.isImpostor;
    title.textContent = 'IMPOSTOR KAZANDI';
    title.className = 'end-title ' + (win?'win':'lose');
    desc.textContent = win ? 'Mürettebatı alt ettin. Kazandın!' : 'Impostor(lar) mürettebatı geride bıraktı. Kaybettin.';
  }
  setTimeout(()=>{ document.getElementById('overlayEnd').classList.add('active'); }, 350);
}
