  state.meetingVotesCast = {};
  state.meetingBotVoted = new Set();
  document.getElementById('meetingTitle').textContent = title;
  const log = document.getElementById('meetingChatLog');
  log.innerHTML = '';
  if(subDesc) addChatLine(null, subDesc, true);
  renderVoteList();
  startMeetingTimer();
  scheduleBotVotes();
  scheduleBotChat();
  document.getElementById('overlayMeeting').classList.add('active');
}
function addChatLine(sender, text, isSystem){
  const log = document.getElementById('meetingChatLog');
  const line = document.createElement('div');
  line.className = 'chat-line';
  if(isSystem){
    line.innerHTML = '<span style="color:var(--accent); font-weight:700;">⚠ '+text+'</span>';
  } else {
    const color = COLORS[sender.colorIdx].hex;
    line.innerHTML = '<span class="who" style="color:'+color+';">'+sender.name+':</span>'+text;
  }
  log.appendChild(line);
  log.scrollTop = log.scrollHeight;
}
const BOT_ARRIVE_LINES = ['selam!', 'merhaba, geldim', 'buradayım', 'oyuna hazırım', 'naber millet', 'geciktim mi?', 'hazırız o zaman', 'hey herkese selam'];
