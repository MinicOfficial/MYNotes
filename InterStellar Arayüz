function render(){
  if(!ctx) return;
  const p = meP();
  const cw = canvas.width, chh = canvas.height;
  state.camera.x = clamp(p.x - cw/2, 0, Math.max(0, WORLD_W - cw));
  state.camera.y = clamp(p.y - chh/2, 0, Math.max(0, WORLD_H - chh));

  ctx.fillStyle = '#04060c';
  ctx.fillRect(0,0,cw,chh);

  ctx.save();
  ctx.translate(-state.camera.x, -state.camera.y);

  drawSpaceStars();

  CORRIDORS.forEach((c,idx)=>{
    const locked = state.doorLocks[idx] && state.doorLocks[idx] > performance.now();
    ctx.fillStyle = locked ? '#3A1420' : '#151F38';
    ctx.fillRect(c.x,c.y,c.w,c.h);
    if(locked){
      ctx.strokeStyle = '#E6484B'; ctx.lineWidth = 3;
      ctx.strokeRect(c.x+3,c.y+3,c.w-6,c.h-6);
    }
  });

  ROOMS.forEach(r=>{
    ctx.fillStyle = '#1A2740';
    ctx.fillRect(r.x, r.y, r.w, r.h);
    ctx.strokeStyle = '#2E3F66';
    ctx.lineWidth = 4;
    ctx.strokeRect(r.x, r.y, r.w, r.h);
  });

  ctx.beginPath();
  ctx.arc(EMERGENCY.x, EMERGENCY.y, 26, 0, Math.PI*2);
  ctx.fillStyle = '#C11F1F';
  ctx.fill();
  ctx.strokeStyle = '#7a0f0f'; ctx.lineWidth=4; ctx.stroke();
  ctx.fillStyle='#fff'; ctx.font='900 18px Orbitron, sans-serif'; ctx.textAlign='center';
  ctx.fillText('!', EMERGENCY.x, EMERGENCY.y+7);

  ctx.save();
  ctx.translate(LIGHTS_FIX.x, LIGHTS_FIX.y);
  ctx.fillStyle = state.lightsOff ? '#E6484B' : '#3A4568';
  roundRectPath(ctx,-16,-14,32,28,6); ctx.fill();
  ctx.strokeStyle = state.lightsOff ? '#ffb3b3' : '#5C6E96'; ctx.lineWidth=2; ctx.stroke();
  ctx.fillStyle = '#fff'; ctx.font='900 16px Rubik, sans-serif'; ctx.textAlign='center';
  ctx.fillText('⚡', 0, 6);
  ctx.restore();
  if(state.lightsOff){
    ctx.fillStyle = '#FFB3B3'; ctx.font='600 12px Rubik, sans-serif'; ctx.textAlign='center';
    ctx.fillText('Işıkları Onar', LIGHTS_FIX.x, LIGHTS_FIX.y+34);
  }

  ctx.save();
  ctx.translate(CAMERA_PANEL.x, CAMERA_PANEL.y);
  ctx.fillStyle = '#3A4568';
  roundRectPath(ctx,-18,-14,36,28,6); ctx.fill();
  ctx.strokeStyle = '#5EC8F2'; ctx.lineWidth=2; ctx.stroke();
  ctx.fillStyle = '#fff'; ctx.font='900 14px Rubik, sans-serif'; ctx.textAlign='center';
  ctx.fillText('📹', 0, 6);
  ctx.restore();
  ctx.fillStyle = '#B7C6E8'; ctx.font='600 12px Rubik, sans-serif'; ctx.textAlign='center';
  ctx.fillText('Kameralar', CAMERA_PANEL.x, CAMERA_PANEL.y+34);

  CAMERAS.forEach(c=>{
    ctx.save();
    ctx.translate(c.x, c.y);
    ctx.fillStyle = '#5EC8F2';
    ctx.beginPath(); ctx.arc(0,0,6,0,Math.PI*2); ctx.fill();
    ctx.restore();
  });

  TASKS_DEF.forEach(t=>{
    if(!p.myTasks.includes(t.id)) return;
    const done = p.tasksDone[t.id];
    if(done && !p.isImpostor) return;
    ctx.save();
    ctx.translate(t.x, t.y);
    ctx.fillStyle = done ? '#3ED598' : '#FFC857';
    ctx.beginPath();
    ctx.moveTo(0,-14); ctx.lineTo(12,10); ctx.lineTo(-12,10); ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#251A02';
    ctx.font='900 14px Rubik, sans-serif'; ctx.textAlign='center';
    ctx.fillText('!', 0, 6);
    ctx.restore();
    ctx.fillStyle = '#C7D2EA'; ctx.font='600 12px Rubik, sans-serif'; ctx.textAlign='center';
    ctx.fillText(t.label, t.x, t.y+28);
  });

  state.bodies.forEach(b=>{
    ctx.save();
    ctx.translate(b.x,b.y);
    ctx.fillStyle = COLORS[b.ownerColorIdx].hex;
    ctx.beginPath(); ctx.ellipse(0,0,16,10,0.3,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='rgba(0,0,0,0.5)'; ctx.lineWidth=2; ctx.stroke();
    ctx.fillStyle = '#0007';
    ctx.beginPath(); ctx.arc(-8,-2,3,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(2,4,3,0,Math.PI*2); ctx.fill();
    ctx.restore();
  });

  const renderList = state.players.filter(pl=>pl.alive && pl.arrived!==false);
  if(!p.alive) renderList.push(p);
  renderList.sort((a,b)=>a.y-b.y);
  renderList.forEach(pl=>{
    const isGhost = !pl.alive;
    if(isGhost){ ctx.save(); ctx.globalAlpha = 0.45; }
    drawCharacter(ctx, pl.x, pl.y, 1, pl, {showName:true, facing: pl.facing||'right', walking: pl.walking, walkT: pl.walkT||0});
    if(isGhost){ ctx.restore(); }
  });

  ctx.restore();
}

let spaceStars = null;
function drawSpaceStars(){
  if(!spaceStars){
    spaceStars = [];
    for(let i=0;i<220;i++){
      spaceStars.push({x:Math.random()*WORLD_W, y:Math.random()*WORLD_H, r:Math.random()*1.4+0.3});
    }
  }
  ctx.fillStyle = '#0A0F1E';
  ctx.fillRect(0,0,WORLD_W,WORLD_H);
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  spaceStars.forEach(s=>{
    ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2); ctx.fill();
  });
}

