<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Notlar</title>
<style>
  :root {
    --bg: #f3f3f5;
    --surface: #ffffff;
    --text: #151517;
    --muted: #767983;
    --line: #e2e3e8;
    --accent: #2f7df6;
    --accent-soft: #e3edff;
    --accent-text: #1b5fd1;
    --toast-bg: #2b2b2f;
    --toast-ink: #ffffff;
    --danger: #d1343a;
    --danger-text: #c62828;
    --surface-2: #eceef2;
    --shadow: 0 1px 2px rgba(0,0,0,.05), 0 10px 28px rgba(0,0,0,.09);
    --paper: #ffffff;
    color-scheme: light;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #000000;
      --surface: #1c1c1f;
      --text: #f2f2f4;
      --muted: #9a9ca6;
      --line: #2c2c31;
      --accent: #3e8bff;
      --accent-soft: #1b2d4b;
      --accent-text: #8ab8ff;
      --toast-bg: #e8e8ec;
      --toast-ink: #111114;
      --danger: #d1343a;
      --danger-text: #ff8a84;
      --surface-2: #2a2a2e;
      --shadow: 0 1px 2px rgba(0,0,0,.5), 0 10px 28px rgba(0,0,0,.5);
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #000000;
    --surface: #1c1c1f;
    --text: #f2f2f4;
    --muted: #9a9ca6;
    --line: #2c2c31;
    --accent: #3e8bff;
    --accent-soft: #1b2d4b;
    --accent-text: #8ab8ff;
    --toast-bg: #e8e8ec;
    --toast-ink: #111114;
      --danger: #d1343a;
      --danger-text: #ff8a84;
      --surface-2: #2a2a2e;
    --shadow: 0 1px 2px rgba(0,0,0,.5), 0 10px 28px rgba(0,0,0,.5);
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { height: 100%; overflow: hidden; scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    height: 100%;
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "SamsungOne", "Samsung Sans", "Roboto", "Noto Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-tap-highlight-color: transparent;
    overscroll-behavior: none;
  }
  [hidden] { display: none !important; }
  button { font: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  #app { position: relative; height: 100%; }
  .view { position: absolute; inset: 0; display: flex; flex-direction: column; background: var(--bg); }

  /* ---------- Not listesi ---------- */
  .list-scroll { flex: 1; overflow-y: auto; padding: 0 16px 120px; }
  .list-inner { max-width: 760px; margin: 0 auto; }
  .big-head { padding: 72px 8px 20px; }
  .big-head h1 { margin: 0; font-size: 34px; font-weight: 500; letter-spacing: -0.01em; line-height: 1.15; }
  .big-head p { margin: 4px 0 0; font-size: 14px; color: var(--muted); min-height: 1.3em; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .card {
    display: flex; flex-direction: column; gap: 4px; width: 100%;
    padding: 10px 10px 14px; border: 0; border-radius: 24px;
    background: var(--surface); text-align: left; cursor: pointer;
  }
  .thumb {
    display: block; width: 100%; aspect-ratio: 3 / 4; border-radius: 16px;
    background: #fff; border: 1px solid var(--line); margin-bottom: 8px;
  }
  .ct { padding: 0 6px; font-size: 16px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cd { padding: 0 6px; font-size: 13px; color: var(--muted); }

  .empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 56px 24px; gap: 6px; }
  .empty .pair { display: flex; gap: 10px; margin-bottom: 14px; }
  .empty .pair svg { width: 30px; height: 60px; }
  .empty .pair svg:first-child { transform: rotate(-12deg); }
  .empty .pair svg:last-child { transform: rotate(10deg); }
  .empty h2 { margin: 0; font-size: 19px; font-weight: 600; }
  .empty p { margin: 0; font-size: 15px; color: var(--muted); max-width: 26ch; line-height: 1.45; }

  .fab {
    position: absolute; right: 20px; bottom: 24px; width: 64px; height: 64px;
    border: 0; border-radius: 22px; background: var(--accent); color: #fff;
    display: grid; place-items: center; cursor: pointer; box-shadow: var(--shadow);
  }
  .fab svg { width: 28px; height: 28px; }

  /* ---------- Editör ---------- */
  .bar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; min-height: 64px; }
  .icon-btn {
    flex: none; width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: transparent; display: grid; place-items: center; cursor: pointer;
  }
  .icon-btn svg { width: 24px; height: 24px; }
  .titlebox { flex: 1; min-width: 0; }
  .titlebox input {
    width: 100%; border: 0; background: transparent; color: var(--text);
    font-family: inherit; font-size: 19px; font-weight: 600; line-height: 1.3; padding: 2px 0; outline: none;
    border-radius: 2px; caret-color: var(--accent); text-overflow: ellipsis;
  }
  .titlebox input::placeholder { color: var(--muted); font-weight: 500; }
  .titlebox input:focus-visible { box-shadow: 0 2px 0 var(--accent); }
  .status { font-size: 12.5px; color: var(--muted); min-height: 1.3em; }
  .status[data-state="dirty"] { color: var(--accent-text); }
  .status[data-state="fail"] { color: #d6403a; }
  .save-btn {
    flex: none; height: 40px; padding: 0 16px; border: 0; border-radius: 20px;
    background: var(--accent-soft); color: var(--accent-text); font-weight: 600; font-size: 15px; cursor: pointer;
  }

  .desk { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 4px 12px 132px; }
  .page {
    position: relative; width: min(100%, 680px); margin: 0 auto; aspect-ratio: 2 / 5;
    background: var(--paper); border-radius: 20px; box-shadow: var(--shadow); overflow: hidden;
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  .page canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
  .hint {
    position: absolute; top: 28px; left: 0; right: 0; padding: 0 28px; text-align: center;
    color: #a3a5ae; font-size: 15px; line-height: 1.5; pointer-events: none; transition: opacity .2s;
  }
  .hint.gone { opacity: 0; }
  .page[data-paper="black"] { background: #0f0f11; box-shadow: 0 0 0 1px var(--line), var(--shadow); }
  .page[data-paper="black"] .hint { color: #6d6f79; }

  .tools {
    position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%);
    display: flex; gap: 4px; padding: 6px; border-radius: 34px;
    background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .tool {
    display: flex; align-items: flex-end; gap: 8px; height: 52px; padding: 0 18px 0 12px;
    border: 0; border-radius: 26px; background: transparent; overflow: hidden; cursor: pointer;
    font-size: 14px; font-weight: 500; white-space: nowrap;
  }
  .tool svg { width: 20px; height: 40px; flex: none; transform: translateY(9px); transition: transform .18s ease; }
  .tool span { align-self: center; }
  .tool[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent-text); }
  .tool[aria-pressed="true"] svg { transform: translateY(0); }

  .toast {
    position: fixed; left: 50%; bottom: calc(100px + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%); max-width: calc(100% - 32px); z-index: 40;
    padding: 10px 18px; border-radius: 22px; background: var(--toast-bg); color: var(--toast-ink);
    font-size: 14px; text-align: center; opacity: 0; pointer-events: none; transition: opacity .2s;
  }
  .toast.on { opacity: 1; }

  /* ---------- Menü ve silme onayı ---------- */
  .menu {
    position: absolute; top: 60px; right: 12px; z-index: 10; min-width: 232px; padding: 8px;
    border-radius: 22px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .menu-label { padding: 8px 12px 4px; font-size: 13px; color: var(--muted); }
  .menu-item {
    display: flex; align-items: center; gap: 12px; width: 100%; height: 46px; padding: 0 12px;
    border: 0; border-radius: 14px; background: transparent; font-size: 16px; text-align: left; cursor: pointer;
  }
  .menu-item:hover { background: var(--surface-2); }
  .menu-item svg { width: 22px; height: 22px; flex: none; }
  .menu-item .ck { margin-left: auto; color: var(--accent-text); opacity: 0; }
  .menu-item[aria-checked="true"] .ck { opacity: 1; }
  .menu-item.danger { color: var(--danger-text); }
  .sw { width: 22px; height: 22px; flex: none; border-radius: 50%; border: 1.5px solid var(--line); }
  .sw-white { background: #ffffff; }
  .sw-black { background: #0f0f11; }
  .menu-sep { height: 1px; margin: 6px 8px; border: 0; background: var(--line); }

  .scrim {
    position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; justify-content: center;
    padding: 16px 16px calc(16px + env(safe-area-inset-bottom, 0px)); background: rgba(0,0,0,.45);
  }
  .sheet { width: min(100%, 420px); padding: 24px 20px 20px; border-radius: 28px; background: var(--surface); box-shadow: var(--shadow); }
  .sheet h2 { margin: 0 0 6px; font-size: 20px; font-weight: 600; }
  .sheet p { margin: 0; font-size: 15px; line-height: 1.45; color: var(--muted); overflow-wrap: anywhere; }
  .acts { display: flex; gap: 10px; margin-top: 22px; }
  .btn { flex: 1; height: 48px; border: 0; border-radius: 24px; background: var(--surface-2); font-size: 16px; font-weight: 600; cursor: pointer; }
  .btn.danger { background: var(--danger); color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .tool svg, .hint, .toast { transition: none; }
  }
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="i-pencil" viewBox="0 0 24 48">
      <path d="M12 2 L8 14 H12 Z" fill="#f2d6a8"/>
      <path d="M12 2 L16 14 H12 Z" fill="#dfb884"/>
      <path d="M12 2 L10.6 6.2 H13.4 Z" fill="#3b3c42"/>
      <rect x="8" y="14" width="4" height="34" fill="#f7cd4f"/>
      <rect x="12" y="14" width="4" height="34" fill="#e6ac26"/>
    </symbol>
    <symbol id="i-red" viewBox="0 0 24 48">
      <path d="M12 2 L9.4 11 H14.6 Z" fill="#e5252a"/>
      <rect x="8" y="11" width="8" height="6" rx="1" fill="#2c2c31"/>
      <rect x="8" y="17" width="8" height="31" fill="#f0f0f3" stroke="#c9cbd3" stroke-width=".6"/>
      <rect x="12.5" y="17.3" width="3.2" height="30.7" fill="#dcdce1"/>
      <rect x="8" y="22" width="8" height="3" fill="#e5252a"/>
    </symbol>
    <symbol id="i-back" viewBox="0 0 24 24">
      <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-new" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20l1.2-4.4L16.6 4.2a2.2 2.2 0 0 1 3.1 0l.1.1a2.2 2.2 0 0 1 0 3.1L8.4 18.8 4 20z"/>
        <path d="M14.5 6.3l3.2 3.2"/>
        <path d="M17 18h5M19.5 15.5v5"/>
      </g>
    </symbol>
    <symbol id="i-more" viewBox="0 0 24 24">
      <g fill="currentColor"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></g>
    </symbol>
    <symbol id="i-trash" viewBox="0 0 24 24">
      <path d="M4 7h16M9 7V4.5h6V7M6.5 7l1 13h9l1-13M10 11v6M14 11v6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
    <symbol id="i-check" viewBox="0 0 24 24">
      <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
  </defs>
</svg>

<div id="app">

  <!-- Not listesi -->
  <section id="listView" class="view" aria-label="Notlar">
    <div class="list-scroll">
      <div class="list-inner">
        <header class="big-head">
          <h1>Notlar</h1>
          <p id="count"></p>
        </header>
        <ul id="grid" class="grid"></ul>
        <div id="empty" class="empty" hidden>
          <div class="pair" aria-hidden="true">
            <svg><use href="#i-pencil"/></svg>
            <svg><use href="#i-red"/></svg>
          </div>
          <h2>Henüz not yok</h2>
          <p>Sağ alttaki düğmeyle ilk notunu oluştur.</p>
        </div>
      </div>
    </div>
    <button id="fab" class="fab" type="button" aria-label="Yeni not">
      <svg aria-hidden="true"><use href="#i-new"/></svg>
    </button>
  </section>

  <!-- Editör -->
  <section id="editView" class="view" aria-label="Not düzenleyici" hidden>
    <header class="bar">
      <button id="backBtn" class="icon-btn" type="button" aria-label="Notlara dön">
        <svg aria-hidden="true"><use href="#i-back"/></svg>
      </button>
      <div class="titlebox">
        <input id="titleIn" type="text" placeholder="Başlık" maxlength="80" autocomplete="off" enterkeyhint="done" aria-label="Not başlığı">
        <div id="status" class="status" aria-live="polite">Yeni not</div>
      </div>
      <button id="saveBtn" class="save-btn" type="button">Kaydet</button>
      <button id="menuBtn" class="icon-btn" type="button" aria-label="Daha fazla" aria-haspopup="menu" aria-expanded="false" aria-controls="menu">
        <svg aria-hidden="true"><use href="#i-more"/></svg>
      </button>
    </header>

    <div id="menu" class="menu" role="menu" aria-label="Not seçenekleri" hidden>
      <div class="menu-label" id="paperLabel">Kağıt</div>
      <div role="group" aria-labelledby="paperLabel">
        <button class="menu-item" type="button" role="menuitemradio" aria-checked="true" data-paper="white">
          <span class="sw sw-white" aria-hidden="true"></span>Beyaz kağıt
          <svg class="ck" aria-hidden="true"><use href="#i-check"/></svg>
        </button>
        <button class="menu-item" type="button" role="menuitemradio" aria-checked="false" data-paper="black">
          <span class="sw sw-black" aria-hidden="true"></span>Siyah kağıt
          <svg class="ck" aria-hidden="true"><use href="#i-check"/></svg>
        </button>
      </div>
      <hr class="menu-sep">
      <button id="menuDelete" class="menu-item danger" type="button" role="menuitem">
        <svg aria-hidden="true"><use href="#i-trash"/></svg>Notu sil
      </button>
    </div>

    <div id="desk" class="desk">
      <div id="page" class="page">
        <canvas id="canvas" aria-label="Yazı alanı"></canvas>
        <div id="hint" class="hint">Bir kalem seç ve yazmaya başla.<br>Sayfayı kaydırmak için iki parmağını kullan.</div>
      </div>
    </div>

    <div class="tools" role="group" aria-label="Kalemler">
      <button class="tool" type="button" data-tool="pencil" aria-pressed="true">
        <svg aria-hidden="true"><use href="#i-pencil"/></svg><span>Kurşun kalem</span>
      </button>
      <button class="tool" type="button" data-tool="red" aria-pressed="false">
        <svg aria-hidden="true"><use href="#i-red"/></svg><span>Kırmızı kalem</span>
      </button>
    </div>
  </section>

</div>

<div id="dlg" class="scrim" hidden>
  <div class="sheet" role="alertdialog" aria-modal="true" aria-labelledby="dlgTitle" aria-describedby="dlgText">
    <h2 id="dlgTitle">Notu sil</h2>
    <p id="dlgText"></p>
    <div class="acts">
      <button id="dlgCancel" class="btn" type="button">Vazgeç</button>
      <button id="dlgOk" class="btn danger" type="button">Sil</button>
    </div>
  </div>
</div>

<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script>
(() => {
  'use strict';

  /* ---------- Sabitler ---------- */
  const PAGE_W = 600, PAGE_H = 1500;           // sayfanın mantıksal boyutu
  const WIDTH = { pencil: 2.8, red: 3.4 };     // kalem kalınlıkları
  const PALETTE = {                            // kâğıt rengine göre kalem renkleri
    white: {
      fill: '#ffffff',
      pencil: { color: '#5a5b62', gap: 'rgba(255,255,255,0.55)', dust: 'rgba(35,35,40,0.35)' },
      red:    { color: '#e5252a' }
    },
    black: {
      fill: '#0f0f11',
      pencil: { color: '#c9cad2', gap: 'rgba(15,15,17,0.55)', dust: 'rgba(255,255,255,0.35)' },
      red:    { color: '#ff4a52' }
    }
  };
  const IDX_KEY = 'notes:index:v1';
  const TOOL_KEY = 'notes:tool';
  const PAPER_KEY = 'notes:paper';
  const noteKey = id => 'notes:note:' + id;

  /* ---------- Depolama (localStorage, olmazsa bellek) ---------- */
  const mem = {};
  const store = {
    get(k) {
      if (k in mem) return mem[k];
      try { return localStorage.getItem(k); } catch (e) { return null; }
    },
    set(k, v) {
      try { localStorage.setItem(k, v); delete mem[k]; return true; }
      catch (e) { mem[k] = v; return false; }
    },
    remove(k) {
      delete mem[k];
      try { localStorage.removeItem(k); } catch (e) {}
    }
  };
  function readIndex() {
    try { const a = JSON.parse(store.get(IDX_KEY) || '[]'); return Array.isArray(a) ? a : []; }
    catch (e) { return []; }
  }
  function readNote(id) {
    try {
      const n = JSON.parse(store.get(noteKey(id)));
      if (n && Array.isArray(n.strokes)) return n;
    } catch (e) {}
    return null;
  }
  function removeNote(id) {
    store.remove(noteKey(id));
    store.set(IDX_KEY, JSON.stringify(readIndex().filter(n => n.id !== id)));
  }

  /* ---------- Elemanlar ---------- */
  const $ = id => document.getElementById(id);
  const listView = $('listView'), editView = $('editView');
  const grid = $('grid'), countEl = $('count'), emptyEl = $('empty');
  const titleIn = $('titleIn'), statusEl = $('status');
  const desk = $('desk'), page = $('page'), canvas = $('canvas'), hint = $('hint');
  const menu = $('menu'), menuBtn = $('menuBtn');
  const dlg = $('dlg'), dlgText = $('dlgText'), dlgCancel = $('dlgCancel'), dlgOk = $('dlgOk');
  const toastEl = $('toast');
  const ctx = canvas.getContext('2d');

  /* ---------- Çizim ---------- */
  function mulberry32(a) {
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  // Kurşun kalem dokusu: kâğıt tanesi ve grafit tozu
  function grain(c, s, j, sx, sy, ex, ey, w, pc) {
    const L = Math.hypot(ex - sx, ey - sy);
    const cnt = Math.ceil(L * 2.2) + 1;
    const rnd = mulberry32((s.seed + j * 7919) >>> 0);
    const nx = L ? -(ey - sy) / L : 0, ny = L ? (ex - sx) / L : 0;
    for (let i = 0; i < cnt; i++) {
      const t = rnd();
      const off = (rnd() - 0.5) * w * 1.5;
      const px = sx + (ex - sx) * t + nx * off;
      const py = sy + (ey - sy) * t + ny * off;
      const sz = 0.5 + rnd() * 0.7;
      c.fillStyle = rnd() < 0.45 ? pc.gap : pc.dust;
      c.fillRect(px, py, sz, sz);
    }
  }

  // Bir çizginin j. parçasını çizer (canlı çizim ve yeniden çizim aynı sonucu verir)
  function drawSeg(c, s, j, paper) {
    const pal = (PALETTE[paper] || PALETTE.white)[s.t];
    const k = s.k, d = s.d, n = d.length / k;
    const p = k === 3 ? d[k * j + 2] / 100 : 0.5;
    const w = WIDTH[s.t] * (0.6 + 0.8 * p);
    const X = i => d[k * i], Y = i => d[k * i + 1];
    if (n === 1) {
      c.fillStyle = pal.color;
      c.beginPath(); c.arc(X(0), Y(0), w / 2, 0, Math.PI * 2); c.fill();
      return;
    }
    const sx = j === 0 ? X(0) : (X(j - 1) + X(j)) / 2;
    const sy = j === 0 ? Y(0) : (Y(j - 1) + Y(j)) / 2;
    const ex = j === n - 1 ? X(j) : (X(j) + X(j + 1)) / 2;
    const ey = j === n - 1 ? Y(j) : (Y(j) + Y(j + 1)) / 2;
    c.strokeStyle = pal.color; c.lineWidth = w; c.lineCap = 'round'; c.lineJoin = 'round';
    c.beginPath(); c.moveTo(sx, sy);
    if (j === 0 || j === n - 1) c.lineTo(ex, ey);
    else c.quadraticCurveTo(X(j), Y(j), ex, ey);
    c.stroke();
    if (s.t === 'pencil') grain(c, s, j, sx, sy, ex, ey, w, pal);
  }
  function drawStroke(c, s, paper) {
    const n = s.d.length / s.k;
    for (let j = 0; j < n; j++) drawSeg(c, s, j, paper);
  }

  /* ---------- Durum ---------- */
  let note = null;          // açık not
  let dirty = false;
  let saveFailed = false;
  let tool = 'pencil';
  let defaultPaper = 'white';
  let K = 1;                // mantıksal -> piksel ölçeği
  let cur = null;           // çizilmekte olan çizgi
  let drawingId = null, drawingType = null;
  let autoT = 0;

  try { const t = store.get(TOOL_KEY); if (t && WIDTH[t]) tool = t; } catch (e) {}
  if (store.get(PAPER_KEY) === 'black') defaultPaper = 'black';

  /* ---------- Tuval boyutu ---------- */
  function layoutCanvas() {
    const r = page.getBoundingClientRect();
    if (!r.width || !note) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = Math.round(r.width * dpr), h = Math.round(r.height * dpr);
    if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
    K = canvas.width / PAGE_W;
    redraw();
  }
  function redraw() {
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (!note) return;
    ctx.setTransform(K, 0, 0, K, 0, 0);
    for (const s of note.strokes) drawStroke(ctx, s, note.paper);
    if (cur) for (let j = 0; j < cur.drawn; j++) drawSeg(ctx, cur, j, note.paper);
  }
  new ResizeObserver(layoutCanvas).observe(page);

  /* ---------- Kaydetme ---------- */
  function setStatus() {
    if (saveFailed) { statusEl.textContent = 'Kalıcı kaydedilemedi'; statusEl.dataset.state = 'fail'; }
    else if (dirty) { statusEl.textContent = 'Kaydedilmedi'; statusEl.dataset.state = 'dirty'; }
    else if (note && note.saved) { statusEl.textContent = 'Kaydedildi'; statusEl.dataset.state = 'ok'; }
    else { statusEl.textContent = 'Yeni not'; statusEl.dataset.state = 'new'; }
  }
  function markDirty() {
    dirty = true; setStatus();
    clearTimeout(autoT);
    autoT = setTimeout(() => { if (dirty) persist(); }, 2000);
  }
  function persist() {
    clearTimeout(autoT);
    if (!note) return 'blank';
    const blank = !note.strokes.length && !note.title.trim();
    if (blank && !note.saved) { dirty = false; setStatus(); return 'blank'; }
    note.updated = Date.now();
    const okNote = store.set(noteKey(note.id), JSON.stringify({
      id: note.id, title: note.title, paper: note.paper, updated: note.updated, strokes: note.strokes
    }));
    const idx = readIndex().filter(n => n.id !== note.id);
    idx.push({ id: note.id, title: note.title, updated: note.updated });
    const okIdx = store.set(IDX_KEY, JSON.stringify(idx));
    note.saved = true; dirty = false;
    saveFailed = !(okNote && okIdx);
    setStatus();
    return saveFailed ? 'mem' : 'ok';
  }

  let toastT = 0;
  function toast(msg) {
    toastEl.textContent = msg; toastEl.classList.add('on');
    clearTimeout(toastT);
    toastT = setTimeout(() => toastEl.classList.remove('on'), 2000);
  }

  /* ---------- Kalem girişi ---------- */
  const touches = new Map();
  let scrollMode = false, penSeen = false;

  function centroid() {
    let x = 0, y = 0;
    touches.forEach(t => { x += t.x; y += t.y; });
    const n = touches.size || 1;
    return { x: x / n, y: y / n };
  }
  function updateHint() { hint.classList.toggle('gone', !!(note && note.strokes.length) || !!cur); }

  function addPoint(e, rect) {
    const sc = PAGE_W / rect.width;
    let x = (e.clientX - rect.left) * sc, y = (e.clientY - rect.top) * sc;
    x = Math.min(PAGE_W, Math.max(0, x)); y = Math.min(PAGE_H, Math.max(0, y));
    x = Math.round(x * 10) / 10; y = Math.round(y * 10) / 10;
    const k = cur.k, d = cur.d, n = d.length / k;
    if (n > 0) {
      const dx = x - d[k * (n - 1)], dy = y - d[k * (n - 1) + 1];
      if (dx * dx + dy * dy < 1) return;
    }
    d.push(x, y);
    if (k === 3) d.push(Math.max(1, Math.round((e.pressure || 0.5) * 100)));
  }
  function flush() {
    const n = cur.d.length / cur.k;
    while (cur.drawn <= n - 2) drawSeg(ctx, cur, cur.drawn++, note.paper);
  }
  function cancelStroke() {
    if (!cur) return;
    cur = null; drawingId = null; drawingType = null;
    redraw(); updateHint();
  }
  function endStroke() {
    if (!cur) return;
    const n = cur.d.length / cur.k;
    while (cur.drawn < n) drawSeg(ctx, cur, cur.drawn++, note.paper);
    note.strokes.push({ t: cur.t, seed: cur.seed, k: cur.k, d: cur.d });
    cur = null; drawingId = null; drawingType = null;
    updateHint(); markDirty();
  }

  canvas.addEventListener('contextmenu', e => e.preventDefault());

  canvas.addEventListener('pointerdown', e => {
    if (!note) return;
    if (document.activeElement === titleIn) titleIn.blur();
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    if (e.pointerType === 'pen') penSeen = true;

    if (e.pointerType === 'touch') {
      touches.set(e.pointerId, { x: e.clientX, y: e.clientY });
      try { canvas.setPointerCapture(e.pointerId); } catch (_) {}
      // İki parmak (ya da kalem kullanılıyorsa tek parmak) = sayfayı kaydır
      if (penSeen || touches.size >= 2 || scrollMode) {
        if (cur && drawingType === 'touch') cancelStroke();
        scrollMode = true;
        return;
      }
    }
    if (cur) return;

    e.preventDefault();
    const pen = e.pointerType === 'pen';
    cur = { t: tool, seed: (Math.random() * 4294967295) >>> 0, k: pen ? 3 : 2, d: [], drawn: 0 };
    drawingId = e.pointerId; drawingType = e.pointerType;
    try { canvas.setPointerCapture(e.pointerId); } catch (_) {}
    addPoint(e, canvas.getBoundingClientRect());
    updateHint();
  });

  canvas.addEventListener('pointermove', e => {
    if (e.pointerType === 'touch' && touches.has(e.pointerId)) {
      const t = touches.get(e.pointerId);
      if (scrollMode) {
        const before = centroid();
        t.x = e.clientX; t.y = e.clientY;
        desk.scrollTop -= centroid().y - before.y;
        return;
      }
      t.x = e.clientX; t.y = e.clientY;
    }
    if (cur && e.pointerId === drawingId) {
      e.preventDefault();
      const rect = canvas.getBoundingClientRect();
      const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [];
      for (const ev of (evs.length ? evs : [e])) addPoint(ev, rect);
      flush();
    }
  });

  function onUp(e) {
    if (e.pointerType === 'touch') {
      touches.delete(e.pointerId);
      if (touches.size === 0) scrollMode = false;
    }
    if (cur && e.pointerId === drawingId) {
      if (e.type === 'pointerup') addPoint(e, canvas.getBoundingClientRect());
      endStroke();
    }
  }
  canvas.addEventListener('pointerup', onUp);
  canvas.addEventListener('pointercancel', onUp);

  /* ---------- Kalem seçimi ---------- */
  const toolBtns = document.querySelectorAll('.tool');
  function setTool(t) {
    tool = t;
    toolBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tool === t)));
    store.set(TOOL_KEY, t);
  }
  toolBtns.forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool)));
  setTool(tool);

  /* ---------- Kâğıt rengi ---------- */
  const paperBtns = menu.querySelectorAll('[data-paper]');
  function applyPaper() {
    const p = note ? note.paper : defaultPaper;
    page.dataset.paper = p;
    paperBtns.forEach(b => b.setAttribute('aria-checked', String(b.dataset.paper === p)));
  }
  function setPaper(p) {
    closeMenu(true);
    if (!note || note.paper === p) return;
    note.paper = p;
    defaultPaper = p;
    store.set(PAPER_KEY, p);
    applyPaper(); redraw(); markDirty();
  }
  paperBtns.forEach(b => b.addEventListener('click', () => setPaper(b.dataset.paper)));

  /* ---------- Menü ---------- */
  function openMenu() {
    menu.hidden = false;
    menuBtn.setAttribute('aria-expanded', 'true');
    (menu.querySelector('[aria-checked="true"]') || menu.querySelector('.menu-item')).focus();
  }
  function closeMenu(refocus) {
    if (menu.hidden) return;
    menu.hidden = true;
    menuBtn.setAttribute('aria-expanded', 'false');
    if (refocus) menuBtn.focus();
  }
  menuBtn.addEventListener('click', () => (menu.hidden ? openMenu() : closeMenu(true)));
  document.addEventListener('pointerdown', e => {
    if (!menu.hidden && !menu.contains(e.target) && !menuBtn.contains(e.target)) closeMenu();
  });
  menu.addEventListener('keydown', e => {
    const items = Array.from(menu.querySelectorAll('.menu-item'));
    const i = items.indexOf(document.activeElement);
    if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
    else if (e.key === 'Escape') { e.preventDefault(); closeMenu(true); }
    else if (e.key === 'Tab') { closeMenu(); }
  });
  $('menuDelete').addEventListener('click', () => { closeMenu(); if (note) askDelete(note.id); });

  /* ---------- Silme onayı ---------- */
  let pendingId = null, dlgReturn = null;
  function askDelete(id) {
    const it = readIndex().find(n => n.id === id);
    const title = ((note && note.id === id) ? note.title : (it && it.title)) || '';
    pendingId = id;
    dlgReturn = document.activeElement;
    dlgText.textContent = '“' + (title.trim() || 'Başlıksız not') + '” kalıcı olarak silinecek.';
    dlg.hidden = false;
    dlgCancel.focus();
  }
  function closeDlg() {
    dlg.hidden = true; pendingId = null;
    if (dlgReturn && document.contains(dlgReturn)) { try { dlgReturn.focus(); } catch (e) {} }
    dlgReturn = null;
  }
  dlgCancel.addEventListener('click', closeDlg);
  dlg.addEventListener('pointerdown', e => { if (e.target === dlg) closeDlg(); });
  dlg.addEventListener('keydown', e => {
    if (e.key === 'Escape') { e.preventDefault(); closeDlg(); }
    else if (e.key === 'Tab') {
      e.preventDefault();
      const f = [dlgCancel, dlgOk], i = f.indexOf(document.activeElement);
      f[(i + (e.shiftKey ? -1 : 1) + 2) % 2].focus();
    }
  });
  dlgOk.addEventListener('click', () => {
    const id = pendingId;
    if (!id) return;
    const wasOpen = !!(note && note.id === id);
    dlgReturn = null; closeDlg();
    removeNote(id);
    if (wasOpen) exitEditor(false); else renderList();
    toast('Not silindi');
  });

  /* ---------- Ekranlar ---------- */
  function fmt(ts) {
    const d = new Date(ts), now = new Date();
    const date = d.toLocaleDateString('tr-TR', d.getFullYear() === now.getFullYear()
      ? { day: 'numeric', month: 'short' }
      : { day: 'numeric', month: 'short', year: 'numeric' });
    const time = d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    return date + ' ' + time;
  }

  function drawThumb(cv, strokes, paper) {
    const c = cv.getContext('2d');
    const k = cv.width / PAGE_W, viewH = cv.height / k;
    c.setTransform(1, 0, 0, 1, 0, 0);
    c.fillStyle = (PALETTE[paper] || PALETTE.white).fill;
    c.fillRect(0, 0, cv.width, cv.height);
    let minY = Infinity;
    for (const s of strokes) for (let j = 0; j < s.d.length / s.k; j++) minY = Math.min(minY, s.d[s.k * j + 1]);
    const y0 = isFinite(minY) ? Math.min(Math.max(0, minY - 30), PAGE_H - viewH) : 0;
    c.setTransform(k, 0, 0, k, 0, -y0 * k);
    for (const s of strokes) drawStroke(c, s, paper);
  }

  function renderList() {
    const idx = readIndex().sort((a, b) => b.updated - a.updated);
    grid.textContent = '';
    countEl.textContent = idx.length ? idx.length + ' not. Silmek için bir nota uzun bas.' : '';
    emptyEl.hidden = idx.length > 0;
    for (const it of idx) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'card';
      const cv = document.createElement('canvas');
      cv.className = 'thumb'; cv.width = 300; cv.height = 400;
      const t = document.createElement('div');
      t.className = 'ct'; t.textContent = it.title || 'Başlıksız not';
      const dt = document.createElement('div');
      dt.className = 'cd'; dt.textContent = fmt(it.updated);
      b.append(cv, t, dt); li.append(b); grid.append(li);
      const full = readNote(it.id);
      drawThumb(cv, full ? full.strokes : [], full && full.paper === 'black' ? 'black' : 'white');

      // Uzun bas (ya da sağ tık) = silme onayı, dokun = aç
      let lpT = 0, lpFired = false;
      b.addEventListener('pointerdown', e => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        lpFired = false; clearTimeout(lpT);
        lpT = setTimeout(() => { lpFired = true; askDelete(it.id); }, 550);
      });
      ['pointerup', 'pointerleave', 'pointercancel'].forEach(ev => b.addEventListener(ev, () => clearTimeout(lpT)));
      b.addEventListener('contextmenu', e => { e.preventDefault(); clearTimeout(lpT); lpFired = true; askDelete(it.id); });
      b.addEventListener('click', () => { if (lpFired) { lpFired = false; return; } openEditor(it.id); });
    }
  }

  function newId() { return 'n' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

  function openEditor(id) {
    const ex = id ? readNote(id) : null;
    note = ex
      ? { id: ex.id, title: ex.title || '', paper: ex.paper === 'black' ? 'black' : 'white', updated: ex.updated, strokes: ex.strokes, saved: true }
      : { id: newId(), title: '', paper: defaultPaper, updated: 0, strokes: [], saved: false };
    dirty = false; saveFailed = false; cur = null;
    touches.clear(); scrollMode = false;
    titleIn.value = note.title;
    applyPaper();
    listView.hidden = true; editView.hidden = false;
    desk.scrollTop = 0;
    setStatus(); updateHint();
    layoutCanvas();
  }

  function exitEditor(save) {
    cancelStroke(); closeMenu();
    clearTimeout(autoT);
    if (save && dirty) persist();
    dirty = false; saveFailed = false;
    note = null;
    editView.hidden = true; listView.hidden = false;
    renderList();
  }

  $('fab').addEventListener('click', () => openEditor(null));
  $('backBtn').addEventListener('click', () => exitEditor(true));

  titleIn.addEventListener('input', () => { note.title = titleIn.value; markDirty(); });
  titleIn.addEventListener('keydown', e => { if (e.key === 'Enter') titleIn.blur(); });

  function saveNow() {
    if (!note) return;
    const r = persist();
    if (r === 'ok') toast('Not kaydedildi');
    else if (r === 'blank') toast('Boş not kaydedilmez');
    else toast('Kaydedilemedi. Depolama dolu ya da kapalı olabilir.');
  }
  $('saveBtn').addEventListener('click', saveNow);
  document.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's' && note) { e.preventDefault(); saveNow(); }
  });

  function flushOnLeave() { if (note && dirty) persist(); }
  document.addEventListener('visibilitychange', () => { if (document.hidden) flushOnLeave(); });
  window.addEventListener('pagehide', flushOnLeave);

  renderList();
})();
</script>
</body>
</html>
